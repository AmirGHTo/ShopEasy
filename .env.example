# Copy this file to `.env` and replace every value before running `docker compose up`.
# `.env` is git-ignored — never commit real secrets.
# Avoid `;` and `$` in passwords (they are embedded in connection strings).

# PostgreSQL (one superuser "shopeasy"; each service has its own database)
POSTGRES_PASSWORD=change-me-postgres

# RabbitMQ
RABBITMQ_USER=shopeasy
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_ERLANG_COOKIE=change-me-erlang-cookie

# OAuth2 client secrets (Identity registers these; Gateway / Order present them)
GATEWAY_CLIENT_SECRET=change-me-gateway-secret
ORDER_SERVICE_CLIENT_SECRET=change-me-order-service-secret

# Admin UIs
PGADMIN_PASSWORD=change-me-pgadmin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_ANONYMOUS_ENABLED=false

# ── Local development conveniences (keep OFF outside your laptop) ──────────────
# Create alice@shopeasy.com (admin) and bob@shopeasy.com (customer) at startup.
SEED_DEMO_USERS=false
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
# Enables GET /account/token on the gateway (returns the raw JWT for Swagger testing).
EXPOSE_ACCESS_TOKEN=false
