# Copy this file to `.env` and replace every value before running `docker compose up`.
# `.env` is git-ignored — never commit real secrets.
# Avoid `;` and `$` in passwords (they are embedded in connection strings).

# PostgreSQL (one superuser "shopeasy"; each service has its own database)
POSTGRES_PASSWORD=change-me-postgres

# RabbitMQ
RABBITMQ_USER=shopeasy
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_ERLANG_COOKIE=change-me-erlang-cookie

# OAuth2 client secrets (Identity registers these; Gateway / Order present them)
GATEWAY_CLIENT_SECRET=change-me-gateway-secret
ORDER_SERVICE_CLIENT_SECRET=change-me-order-service-secret

# Admin UIs
PGADMIN_PASSWORD=change-me-pgadmin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_ANONYMOUS_ENABLED=false

# ── Local development conveniences (keep OFF outside your laptop) ──────────────
# Create alice@shopeasy.com (admin) and bob@shopeasy.com (customer) at startup.
SEED_DEMO_USERS=false
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
# The first administrator (also for a real deployment): created at startup only while no admin
# exists; afterwards both are ignored and the password can be removed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Enables GET /account/token on the gateway (returns the raw JWT for Swagger testing).
EXPOSE_ACCESS_TOKEN=false

# ── Accounts and sign-up (optional) ────────────────────────────────────────────
# Every value below is the default; uncomment a line only to change it. README, "How to Use It".
# Let visitors create their own (customer) account on the sign-in page; false closes sign-up
# REGISTRATION_ENABLED=true
# Sign-in (and password-change) and sign-up submissions one client may make per window (fixed window, per client address)
# RATE_LIMIT_LOGIN_ATTEMPTS=10
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# RATE_LIMIT_REGISTRATION_ATTEMPTS=10
# RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=3600

# ── Resilience tuning (optional) ───────────────────────────────────────────────
# Every value below is the default; uncomment a line only to change it. What each one does, how to
# size the pool and why the defaults are what they are: README, pattern 24.
# Database limits (all five services with a database)
# RESILIENCE_PG_LOCK_TIMEOUT_SECONDS=10
# RESILIENCE_PG_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=60
# RESILIENCE_PG_COMMAND_TIMEOUT_SECONDS=30
# RESILIENCE_PG_CONNECT_TIMEOUT_SECONDS=15
# RESILIENCE_PG_MAX_POOL_SIZE=20
# RESILIENCE_PG_TCP_KEEPALIVE_SECONDS=30
# Message consumer retries (Order, Inventory, Payment): patient for outages, quick for the rest
# RESILIENCE_CONSUMER_TRANSIENT_RETRY_LIMIT=12
# RESILIENCE_CONSUMER_TRANSIENT_MIN_INTERVAL_SECONDS=1
# RESILIENCE_CONSUMER_TRANSIENT_MAX_INTERVAL_SECONDS=60
# RESILIENCE_CONSUMER_JITTER_RATIO=0.2
# RESILIENCE_CONSUMER_RETRY_LIMIT=3
# RESILIENCE_CONSUMER_MIN_INTERVAL_SECONDS=1
# RESILIENCE_CONSUMER_MAX_INTERVAL_SECONDS=10
# RESILIENCE_CONSUMER_INTERVAL_DELTA_SECONDS=2

# ── Order API: idempotent order placement (optional) ───────────────────────────
# POST /api/orders accepts an Idempotency-Key header (README, "Order API"). Uncomment to change:
# require the header on every request (default: optional), and how long a key is remembered.
# ORDER_IDEMPOTENCY_REQUIRE_KEY=false
# ORDER_IDEMPOTENCY_RETENTION_HOURS=24

# ── Order saga: retries of the first command (optional) ────────────────────────
# When Order cannot send an order's first command (message broker down), it retries after a growing
# pause and cancels the order after MaxAttempts failures. The longest pause must stay below 120 s,
# the saga timeout. Uncomment to change:
# ORDER_SAGA_MAX_ATTEMPTS=8
# ORDER_SAGA_FIRST_RETRY_PAUSE_SECONDS=3
# ORDER_SAGA_MAX_RETRY_PAUSE_SECONDS=60
# Calls between services (README, pattern 26). Order calls Inventory (stock check) and Product; the gateway
# calls every service.
# RESILIENCE_INVENTORY_TIMEOUT_SECONDS=3
# RESILIENCE_INVENTORY_MAX_RETRIES=2
# RESILIENCE_INVENTORY_BREAK_SECONDS=15
# RESILIENCE_GATEWAY_ACTIVITY_TIMEOUT_SECONDS=30
# RESILIENCE_GATEWAY_CONNECT_TIMEOUT_SECONDS=5
# RESILIENCE_GATEWAY_POOLED_CONNECTION_LIFETIME_SECONDS=120
# RESILIENCE_GATEWAY_GET_RETRIES=2
# Share of extra requests that retries may add (Order and gateway)
# RESILIENCE_RETRY_BUDGET_RATIO=0.2
# RESILIENCE_RETRY_BUDGET_MIN_RETRIES=10
# RESILIENCE_RETRY_BUDGET_WINDOW_SECONDS=10

# ── Token validation and browser-facing security (README, "Authorization") ─────────────────────────
# Fetch Identity's discovery document and signing keys only over HTTPS (needs an https:// authority)
# IDENTITY_REQUIRE_HTTPS_METADATA=false
# Secure flag of the login and session cookies: Always | SameAsRequest | None. Use Always when the
# gateway and Identity are reached over HTTPS.
# SECURITY_COOKIE_SECURE_POLICY=SameAsRequest
# Behind a reverse proxy that terminates TLS: believe its X-Forwarded-* headers, but only from the
# listed networks (CIDR, comma-separated) or addresses.
# FORWARDED_HEADERS_ENABLED=false
# FORWARDED_HEADERS_KNOWN_NETWORKS=
# FORWARDED_HEADERS_KNOWN_PROXIES=
