{
  "IdentityServer": {
    "Authority": "http://identity:8080",
    "PublicUrl": "http://localhost:5001",
    "RequireHttpsMetadata": false
  },
  "Logging": {
    "ConsoleFormat": "text",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        },
        "RateLimiterPolicy": "anonymous"
      },
      "products-v1-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/v1/products/{**catch-all}"
        },
        "RateLimiterPolicy": "anonymous"
      },
      "products-v2-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/v2/products/{**catch-all}"
        },
        "RateLimiterPolicy": "anonymous"
      },
      "outbox-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/outbox/{**catch-all}"
        },
        "RateLimiterPolicy": "authenticated",
        "AuthorizationPolicy": "default"
      },
      "orders-create-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders",
          "Methods": [
            "POST"
          ]
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "orders"
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "authenticated"
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "authenticated"
      },
      "payments-monitor-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/payments",
          "Methods": [
            "GET"
          ]
        },
        "RateLimiterPolicy": "authenticated",
        "AuthorizationPolicy": "default"
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "authenticated"
      }
    },
    "Clusters": {
      "products-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://product:8080"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://order:8080"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://inventory:8080"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://payment:8080"
          }
        }
      }
    }
  },
  "Resilience": {
    "Gateway": {
      "ActivityTimeoutSeconds": 30,
      "ConnectTimeoutSeconds": 5,
      "PooledConnectionLifetimeSeconds": 120,
      "GetRetries": 2
    },
    "RetryBudget": {
      "Ratio": 0.2,
      "MinRetriesPerWindow": 10,
      "WindowSeconds": 10
    }
  },
  "Security": {
    "CookieSecurePolicy": "SameAsRequest"
  },
  "RateLimiting": {
    "AnonymousPerMinute": 120,
    "AuthenticatedPerMinute": 100,
    "AdminPerMinute": 500,
    "OrdersPerMinute": 10
  },
  "SecurityHeaders": {
    "Enabled": true,
    "ImageSources": "https:"
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownNetworks": "",
    "KnownProxies": ""
  }
}
