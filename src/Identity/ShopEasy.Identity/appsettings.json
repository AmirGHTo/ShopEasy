{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Resilience": {
    "Postgres": {
      "LockTimeoutSeconds": 10,
      "IdleInTransactionTimeoutSeconds": 60,
      "CommandTimeoutSeconds": 30,
      "ConnectTimeoutSeconds": 15,
      "MaxPoolSize": 20,
      "TcpKeepAliveSeconds": 30
    }
  },
  "Security": {
    "CookieSecurePolicy": "SameAsRequest"
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownNetworks": "",
    "KnownProxies": ""
  }
}
