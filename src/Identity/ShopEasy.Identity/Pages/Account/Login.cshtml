@page
@model ShopEasy.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign In — ShopEasy";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <partial name="_AuthStyles" />
</head>
<body>
<div class="card">
    <div class="logo">
        <h1>ShopEasy</h1>
        <p>Identity Provider — Sign in to continue</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">@Model.ErrorMessage</div>
    }

    <form method="post" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">
        <input type="hidden" asp-for="ReturnUrl" />
        <label asp-for="Input.Email">Email address</label>
        <input asp-for="Input.Email" type="email" autocomplete="email" placeholder="you@example.com" />

        <label asp-for="Input.Password">Password</label>
        <input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="••••••••" />

        <div class="remember">
            <input asp-for="Input.RememberMe" type="checkbox" id="remember" />
            <label for="remember">Keep me signed in</label>
        </div>

        <button type="submit">Sign In</button>
    </form>

    @if (Model.RegistrationEnabled)
    {
        <p class="switch">New here? <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p>
    }
</div>
</body>
</html>
