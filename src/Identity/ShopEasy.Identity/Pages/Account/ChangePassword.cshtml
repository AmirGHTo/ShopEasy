@page
@model ShopEasy.Identity.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password — ShopEasy";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <partial name="_AuthStyles" />
</head>
<body>
<div class="card">
    <div class="logo">
        <h1>ShopEasy</h1>
        <p>Change your password</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="success">@Model.Message</div>
    }
    <div asp-validation-summary="All" class="error"></div>

    <form method="post" asp-page="/Account/ChangePassword">
        <label asp-for="Input.CurrentPassword">Current password</label>
        <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" />

        <label asp-for="Input.NewPassword">New password</label>
        <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" />
        <p class="rules">@ShopEasy.Identity.Configuration.IdentityPolicy.PasswordRules</p>

        <label asp-for="Input.ConfirmPassword">Confirm new password</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />

        <button type="submit">Change password</button>
    </form>

    <p class="switch"><a href="/">Back</a></p>
</div>
</body>
</html>
