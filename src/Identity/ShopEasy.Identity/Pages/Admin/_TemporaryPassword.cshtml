@model ShopEasy.Identity.Pages.Admin.UsersModel.Revealed
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Temporary password — ShopEasy</title>
    <partial name="_AuthStyles" />
</head>
<body>
<div class="card">
    <div class="logo">
        <h1>ShopEasy</h1>
        <p>Temporary password</p>
    </div>

    <div class="success">Temporary password set for @Model.Email.</div>
    <p>Give it to the user over a channel you trust. It is shown only now and cannot be shown again.
       They must replace it with their own at their next sign-in, and everything they were signed in to has ended.</p>
    <div class="secret">@Model.Password</div>
    <p class="switch"><a asp-page="/Admin/Users" asp-route-q="@Model.Q" asp-route-p="@Model.P">Back to the accounts</a></p>
</div>
</body>
</html>
