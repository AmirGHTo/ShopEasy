{
  "Swagger": {
    "Enabled": false
  },
  "IdentityServer": {
    "Authority": "http://identity:8080",
    "RequireHttpsMetadata": false
  },
  "RabbitMQ": {
    "Host": "rabbitmq"
  },
  "Logging": {
    "ConsoleFormat": "text",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "Endpoint": "http://otel-collector:4317",
    "SamplingRatio": 1.0
  },
  "Testing": {
    "ForcePaymentSuccess": false
  },
  "Synthetic": {
    "ProbeEmail": ""
  },
  "Resilience": {
    "Postgres": {
      "LockTimeoutSeconds": 10,
      "IdleInTransactionTimeoutSeconds": 60,
      "CommandTimeoutSeconds": 30,
      "ConnectTimeoutSeconds": 15,
      "MaxPoolSize": 20,
      "TcpKeepAliveSeconds": 30,
      "IdleCheckSeconds": 10
    },
    "Consumers": {
      "TransientRetryLimit": 12,
      "TransientMinIntervalSeconds": 1,
      "TransientMaxIntervalSeconds": 60,
      "JitterRatio": 0.2,
      "RetryLimit": 3,
      "MinIntervalSeconds": 1,
      "MaxIntervalSeconds": 10,
      "IntervalDeltaSeconds": 2
    }
  }
}
