{
  "IdentityServer": {
    "Authority": "http://identity:8080"
  },
  "ServiceAuth": {
    "ClientId": "order-service"
  },
  "Services": {
    "InventoryService": "http://inventory:8080",
    "InventoryGrpcService": "http://inventory:8090",
    "ProductService": "http://product:8080"
  },
  "RabbitMQ": {
    "Host": "rabbitmq"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "Endpoint": "http://jaeger:4317"
  },
  "Redis": {
    "Connection": "redis:6379"
  }
}
