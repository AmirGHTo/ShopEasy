{
  "Swagger": {
    "Enabled": false
  },
  "IdentityServer": {
    "Authority": "http://identity:8080",
    "RequireHttpsMetadata": false
  },
  "ServiceAuth": {
    "ClientId": "order-service"
  },
  "Services": {
    "InventoryGrpcService": "http://inventory:8090",
    "PaymentService": "http://payment:8080",
    "ProductService": "http://product:8080"
  },
  "RabbitMQ": {
    "Host": "rabbitmq"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "Endpoint": "http://jaeger:4317"
  },
  "Redis": {
    "Connection": "redis:6379",
    "ConnectTimeoutMs": 1000,
    "CommandTimeoutMs": 500
  },
  "Resilience": {
    "Postgres": {
      "LockTimeoutSeconds": 10,
      "IdleInTransactionTimeoutSeconds": 60,
      "CommandTimeoutSeconds": 30,
      "ConnectTimeoutSeconds": 15,
      "MaxPoolSize": 20,
      "TcpKeepAliveSeconds": 30,
      "IdleCheckSeconds": 10
    },
    "Consumers": {
      "TransientRetryLimit": 12,
      "TransientMinIntervalSeconds": 1,
      "TransientMaxIntervalSeconds": 60,
      "JitterRatio": 0.2,
      "RetryLimit": 3,
      "MinIntervalSeconds": 1,
      "MaxIntervalSeconds": 10,
      "IntervalDeltaSeconds": 2
    },
    "Inventory": {
      "TimeoutSeconds": 3,
      "MaxRetries": 2,
      "BreakDurationSeconds": 15
    },
    "RetryBudget": {
      "Ratio": 0.2,
      "MinRetriesPerWindow": 10,
      "WindowSeconds": 10
    }
  },
  "Idempotency": {
    "RequireKey": false,
    "RetentionHours": 24
  },
  "Outbox": {
    "QueryDelayMs": 500
  },
  "SagaOrchestrator": {
    "MaxAttempts": 8,
    "FirstRetryPauseSeconds": 3,
    "MaxRetryPauseSeconds": 60
  },
  "BackgroundLoops": {
    "PassTimeoutSeconds": 120
  },
  "ConsistencyCheck": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "SettleSeconds": 120,
    "LookbackMinutes": 30,
    "MaxOrdersPerPass": 500
  }
}
