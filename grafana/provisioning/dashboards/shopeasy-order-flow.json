    {
      "id": 16,
      "type": "stat",
      "title": "Dead letters",
      "description": "Messages that failed all their retries and wait in an error queue for a person. Should be 0. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#deadletterspresent",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (queue) (shopeasy_error_queue_messages))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
