    },
    {
      "id": 15,
      "type": "stat",
      "title": "Oldest saga command waiting",
      "description": "Age of the oldest saga command that RabbitMQ has not taken (0 when none). Above 2 minutes: the broker is unreachable or delivery fails. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#sagacommandsnotsent",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(shopeasy_saga_command_oldest_pending_age_seconds)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
