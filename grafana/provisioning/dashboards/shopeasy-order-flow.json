    {
      "id": 17,
      "type": "timeseries",
      "title": "Outbox and saga commands over time",
      "description": "The two backlogs of the Order service. They grow while RabbitMQ is unreachable and drain by themselves afterwards; do not delete outbox rows. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#outboxbacklog",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(shopeasy_outbox_pending_messages)",
          "legendFormat": "outbox events"
        },
        {
          "refId": "B",
          "expr": "max(shopeasy_saga_commands_pending)",
          "legendFormat": "saga commands"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Polling loops: seconds since the last good pass",
      "description": "How long each background loop of the Order service has gone without completing a pass. The line is the 2 minutes that raises PollingLoopStalled: the loop fails or hangs (usually the database or the broker). Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#pollingloopstalled",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (loop) (shopeasy_background_loop_last_success_timestamp_seconds)",
          "legendFormat": "{{loop}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "Money and consistency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Payments (5 min)",
      "description": "What the payment provider answered. More than 30% declined raises PaymentsDeclinedHigh (the simulated provider declines about 10%). Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#paymentsdeclinedhigh",
