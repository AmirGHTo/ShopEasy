{
  "uid": "shopeasy-order-flow",
  "title": "ShopEasy Order Flow",
  "tags": [
    "shopeasy"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "ShopEasy dashboards",
      "tags": [
        "shopeasy"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "The funnel: placed, stock reserved, paid, confirmed",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Orders per minute at each step",
      "description": "How many orders reach each step per minute: accepted, stock reserved, paid, confirmed. The gap between two lines is where orders are lost or wait: reserved well below placed = stock refusals or a stuck Inventory step; paid below reserved = declined payments or a stuck Payment step. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#orderstuck",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(shopeasy_orders_placed_total[$__rate_interval])) * 60",
          "legendFormat": "1 placed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(shopeasy_saga_step_duration_seconds_count{to=\"ProcessingPayment\"}[$__rate_interval])) * 60",
          "legendFormat": "2 stock reserved"
        },
        {
          "refId": "C",
          "expr": "sum(rate(shopeasy_saga_step_duration_seconds_count{to=\"Completing\"}[$__rate_interval])) * 60",
          "legendFormat": "3 paid"
        },
        {
          "refId": "D",
          "expr": "sum(rate(shopeasy_saga_step_duration_seconds_count{to=\"Completed\"}[$__rate_interval])) * 60",
          "legendFormat": "4 confirmed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Placed (1 h)",
      "description": "Orders accepted in the last hour. Zero while customers should be ordering: the Order service or the gateway is not taking orders. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#servicedown",
      "gridPos": {
        "h": 9,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(shopeasy_orders_placed_total[1h]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Confirmed (1 h)",
      "description": "Orders paid for and confirmed in the last hour. Far below placed, after the settling time of a couple of minutes: orders are cancelled or stuck. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#orderstuck",
      "gridPos": {
        "h": 9,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(shopeasy_order_outcomes_total{outcome=\"confirmed\"}[1h]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outcomes by reason (5 min)",
      "description": "How accepted orders ended in the last 5 minutes. 'failed' or release_not_confirmed need a person: OrderFailed / StockMayHaveLeaked. Many payment_declined cancellations: PaymentsDeclinedHigh. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#orderfailed",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(shopeasy_order_outcomes_total[5m])) by (outcome, reason)",
          "legendFormat": "{{outcome}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Refused at the door (5 min)",
      "description": "Order requests refused before anything was saved, by reason. insufficient_stock is normal; catalog_unavailable and inventory_unreachable mean a dependency is failing. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#dependencydown",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(shopeasy_orders_rejected_total[5m])) by (reason)",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "How long each step takes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Time in each saga step (p95)",
      "description": "How long an order stays in a step before it moves on, by the step it left and the one it entered. A step that gets slower is where to look: ReservingInventory -> ProcessingPayment is Inventory, ProcessingPayment -> Completing is Payment. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#orderstuck",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, from, to) (rate(shopeasy_saga_step_duration_seconds_bucket[5m])))",
          "legendFormat": "{{from}} -> {{to}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Order duration (p95) by result",
      "description": "From accepted to settled, by how it ended. Rising 'completed' times: some step is slow (see the left graph). Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#orderstuck",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, result) (rate(shopeasy_saga_duration_seconds_bucket[5m])))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Stuck and waiting",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Oldest order in progress",
      "description": "Age of the oldest order that is still being processed (0 when none). Above 600 s (10 minutes): OrderStuck. The timeout service should have settled it after 2 minutes. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#orderstuck",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(shopeasy_saga_oldest_active_age_seconds)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Orders in progress",
      "description": "Orders still being processed. Rises with load and falls back. A number that stays high together with a rising oldest age: stuck orders. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#orderstuck",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(shopeasy_sagas_active)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Outbox waiting",
      "description": "Events saved in the Order outbox that RabbitMQ has not taken yet. Normally 0 or a few. Above 50 for 5 minutes: the broker is probably unreachable. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#outboxbacklog",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(shopeasy_outbox_pending_messages)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Saga commands waiting",
      "description": "Saga commands saved in the Order database that RabbitMQ has not taken. Normally 0. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#sagacommandsnotsent",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(shopeasy_saga_commands_pending)",
