    {
      "id": 21,
      "type": "stat",
      "title": "Consistency violations",
      "description": "Settled orders that disagree with what Payment holds for them. Should be 0; anything else needs a person. Nothing is changed automatically. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#orderconsistencyviolated",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 43
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(shopeasy_consistency_violations)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Retries and circuit breakers",
      "description": "Calls between services that were retried or refused a retry (budget exhausted), and how often a circuit breaker changed state. Many 'budget_exhausted' or 'open': a dependency keeps failing. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#dependencydown",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "refId": "A",
