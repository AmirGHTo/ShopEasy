          "expr": "shopeasy:gateway_bad_ratio:rate6h{sli=\"latency\"} / on(sli) shopeasy:slo_budget:ratio",
          "legendFormat": "6 h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "What is going wrong",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Server errors (5xx), share of the gateway's answers",
      "description": "The share of answers over 5 minutes that were a server error, against the objective's 0.5 % (the line). Look at Service Health for which service, then Seq and Jaeger. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#errorbudgetfastburn",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "shopeasy:gateway_bad_ratio:rate5m{sli=\"availability\"}",
          "legendFormat": "5 min"
        },
        {
