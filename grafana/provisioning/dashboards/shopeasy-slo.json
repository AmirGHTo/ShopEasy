          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Slow answers (over 2 s), share of the gateway's answers",
      "description": "The share of answers over 5 minutes that took longer than 2 seconds, against the objective's 5 % (the line). In Jaeger sort the slowest traces and see which span is long. Runbook: https://github.com/AmirGHTo/ShopEasy/blob/main/README.md#errorbudgetslowburn",
      "gridPos": {
        "h": 8,
